            "custom_liquid": "<style>\n  .susans-countdown-bar {\n    width: 100%;\n    background: #07321E;\n    color: #FFFFFF;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 44px;\n    padding: 5px 12px;\n    box-sizing: border-box;\n  }\n\n  .susans-countdown-inner {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    white-space: nowrap;\n  }\n\n  .susans-countdown-title {\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    line-height: 1;\n  }\n\n  .susans-countdown-time {\n    display: flex;\n    align-items: flex-start;\n    gap: 4px;\n  }\n\n  .susans-time-unit {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    min-width: 29px;\n  }\n\n  .susans-time-number {\n    font-size: 21px;\n    font-weight: 700;\n    letter-spacing: 0.5px;\n    line-height: 19px;\n  }\n\n  .susans-time-label {\n    margin-top: 3px;\n    font-size: 6px;\n    font-weight: 600;\n    letter-spacing: 0.7px;\n    text-transform: uppercase;\n    line-height: 1;\n    opacity: 0.95;\n  }\n\n  .susans-time-colon {\n    font-size: 19px;\n    font-weight: 700;\n    line-height: 18px;\n  }\n\n  @media screen and (max-width: 749px) {\n    .susans-countdown-bar {\n      min-height: 40px;\n      padding: 4px 8px;\n    }\n\n    .susans-countdown-inner {\n      gap: 9px;\n    }\n\n    .susans-countdown-title {\n      font-size: 10px;\n      letter-spacing: 1.6px;\n    }\n\n    .susans-time-number {\n      font-size: 19px;\n    }\n\n    .susans-time-colon {\n      font-size: 17px;\n    }\n\n    .susans-time-unit {\n      min-width: 27px;\n    }\n  }\n</style>\n\n<div class=\"susans-countdown-bar\">\n  <div class=\"susans-countdown-inner\">\n\n    <div class=\"susans-countdown-title\">\n      Sale Ends In\n    </div>\n\n    <div class=\"susans-countdown-time\">\n\n      <div class=\"susans-time-unit\">\n        <span class=\"susans-time-number\" id=\"susans-hours\">00</span>\n        <span class=\"susans-time-label\">HRS</span>\n      </div>\n\n      <span class=\"susans-time-colon\">:</span>\n\n      <div class=\"susans-time-unit\">\n        <span class=\"susans-time-number\" id=\"susans-minutes\">00</span>\n        <span class=\"susans-time-label\">MINS</span>\n      </div>\n\n      <span class=\"susans-time-colon\">:</span>\n\n      <div class=\"susans-time-unit\">\n        <span class=\"susans-time-number\" id=\"susans-seconds\">00</span>\n        <span class=\"susans-time-label\">SECS</span>\n      </div>\n\n    </div>\n\n  </div>\n</div>\n\n<script>\n(function() {\n\n  function getNextMidnight() {\n    const now = new Date();\n\n    const midnight = new Date(\n      now.getFullYear(),\n      now.getMonth(),\n      now.getDate() + 1,\n      0,\n      0,\n      0,\n      0\n    );\n\n    return midnight.getTime();\n  }\n\n  let targetTime = getNextMidnight();\n\n  function updateSusansCountdown() {\n    const now = new Date().getTime();\n    let distance = targetTime - now;\n\n    if (distance <= 0) {\n      targetTime = getNextMidnight();\n      distance = targetTime - now;\n    }\n\n    const hours = Math.floor(\n      distance / (1000 * 60 * 60)\n    );\n\n    const minutes = Math.floor(\n      (distance % (1000 * 60 * 60)) / (1000 * 60)\n    );\n\n    const seconds = Math.floor(\n      (distance % (1000 * 60)) / 1000\n    );\n\n    const hoursEl = document.getElementById('susans-hours');\n    const minutesEl = document.getElementById('susans-minutes');\n    const secondsEl = document.getElementById('susans-seconds');\n\n    if (hoursEl) {\n      hoursEl.textContent = String(hours).padStart(2, '0');\n    }\n\n    if (minutesEl) {\n      minutesEl.textContent = String(minutes).padStart(2, '0');\n    }\n\n    if (secondsEl) {\n      secondsEl.textContent = String(seconds).padStart(2, '0');\n    }\n  }\n\n  updateSusansCountdown();\n  setInterval(updateSusansCountdown, 1000);\n\n})();\n</script>",
