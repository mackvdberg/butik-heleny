    "faq_K7V8Pg": {
      "type": "faq",
      "blocks": {
        "question_eCeqhb": {
          "type": "question",
          "settings": {
            "title": "Jak można się z nami skontaktować?",
            "text": "<p>Chętnie pomożemy w doborze rozmiaru, kwestiach związanych z dostawą oraz odpowiemy na pytania dotyczące zamówienia.</p><p>Wystarczy odwiedzić naszą&nbsp;<strong>stronę kontaktową</strong>&nbsp;i wysłać wiadomość. W przypadku istniejącego zamówienia prosimy o podanie&nbsp;<strong>numeru zamówienia</strong>, abyśmy mogli szybciej pomóc.</p>"
          }
        },
        "question_GmBtYt": {
          "type": "question",
          "settings": {
            "title": "Czy można zmienić lub anulować zamówienie?",
            "text": "<p>Jeśli zmienili Państwo zdanie lub zauważyli błąd, prosimy o&nbsp;<strong>jak najszybszy kontakt</strong>&nbsp;z podaniem numeru zamówienia i informacji o potrzebnej zmianie.</p><p>Dołożymy wszelkich starań, aby pomóc. Zmiana lub anulowanie może jednak nie być możliwe, jeśli zamówienie jest już przygotowywane lub zostało wysłane.</p>"
          }
        },
        "question_KzCxXL": {
          "type": "question",
          "settings": {
            "title": "Jak długo trzeba czekać na dostawę zamówienia?",
            "text": "<p>Przygotowanie zamówienia zajmuje&nbsp;<strong>1–3 dni robocze</strong>, a dostawa kolejne&nbsp;<strong>5–8 dni roboczych</strong>. Łączny czas oczekiwania wynosi zazwyczaj&nbsp;<strong>6–11 dni roboczych</strong>.</p><p>Szczegółowe informacje znajdą Państwo na naszej stronie&nbsp;<strong>Informacje o dostawie</strong>.</p>"
          }
        },
        "question_Wj6zaX": {
          "type": "question",
          "settings": {
            "title": "Czy oferują Państwo darmową dostawę?",
            "text": "<p>Tak! Oferujemy&nbsp;<strong>darmową dostawę przy każdym zamówieniu, bez minimalnej kwoty zakupu</strong>.</p><p>To nasz sposób, aby podziękować Państwu za zakupy w&nbsp;<strong>Butik Heleny Kraków</strong>.</p>"
          }
        },
        "question_LwMpbE": {
          "type": "question",
          "settings": {
            "title": "Jak można śledzić zamówienie?",
            "text": "<p>Po wysłaniu zamówienia otrzymają Państwo wiadomość e-mail z&nbsp;<strong>numerem śledzenia przesyłki</strong>.</p><p>Aktualny status dostawy można również sprawdzić na naszej stronie w sekcji&nbsp;<strong>Śledź zamówienie</strong>.</p><p>W razie pytań prosimy o&nbsp;<strong>kontakt</strong>&nbsp;z podaniem numeru zamówienia.</p>"
          }
        },
        "question_JY4bYR": {
          "type": "question",
          "settings": {
            "title": "Jak wybrać odpowiedni rozmiar?",
            "text": "<p>Nasze ubrania mają&nbsp;<strong>standardową rozmiarówkę</strong>. Przy każdym produkcie znajdą Państwo szczegółową&nbsp;<strong>tabelę rozmiarów</strong>, która pomoże wybrać odpowiedni rozmiar i zapewnić wygodne dopasowanie.</p>"
          }
        },
        "question_4jGjhq": {
          "type": "question",
          "settings": {
            "title": "Jakie są zasady zwrotów?",
            "text": "<p>Zakup nie spełnił Państwa oczekiwań? Bez obaw!</p><p>Mogą Państwo zwrócić zamówienie w ciągu&nbsp;<strong>30 dni od jego otrzymania</strong>. Dbamy o to, aby cały proces był prosty i przebiegał sprawnie.</p>"
          }
        }
      },
